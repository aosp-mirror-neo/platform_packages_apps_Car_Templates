package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "host_lib",

    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],

    sdk_version: "system_current",

    resource_dirs: [
        "res/internal",
        "res/view",
        "res/view_common",
        "res/view_dev_presenters",
        "res/view_dev_testing",
        "res/view_dev_widget",
        "res/view_dev_widget_navigation",
        "res/view_presenters_common",
        "res/view_presenters_maps",
        "res/view_presenters_navigation",
        "res/view_widget_common",
        "res/view_widget_navigation",
        "res/view_widget_ui",
    ],

    manifest: "AndroidManifest.xml",

    static_libs: [
        "android.car",
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.car.app_app",
        "androidx.car.app_app-activity",
        "androidx.cardview_cardview",
        "androidx.core_core",
        "androidx.fragment_fragment",
        "androidx.lifecycle_lifecycle-common-java8",
        "androidx.lifecycle_lifecycle-livedata-core",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.recyclerview_recyclerview",
        "androidx-constraintlayout_constraintlayout",
        "car_apphost",
        "car-ui-lib",
        "dagger2",
        "framework-annotations-lib",
        "guava-android",
        "hilt_android",
    ],

    plugins: ["dagger2-compiler"],
}

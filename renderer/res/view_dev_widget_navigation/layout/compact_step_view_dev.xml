<com.android.car.libraries.templates.host.view_dev.widget.navigation.CompactStepView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/compact_step_view_height"
    android:orientation="horizontal">

  <!-- An image showing the turn icon on the left of the view. -->
  <ImageView
      android:id="@+id/compact_turn_symbol"
      android:layout_width="@dimen/compact_step_turn_icon_size"
      android:layout_height="@dimen/compact_step_turn_icon_size"
      android:scaleType="fitCenter"
      android:adjustViewBounds="true"
      android:layout_gravity="center"
      android:layout_marginStart="@dimen/template_padding_2"
      tools:ignore="ContentDescription" />

  <!-- A text view displaying the description of the step, e.g. "Boggle St". -->
  <TextView
      android:id="@+id/compact_description_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/template_padding_1"
      android:layout_gravity="start|center" />
</com.android.car.libraries.templates.host.view_dev.widget.navigation.CompactStepView>

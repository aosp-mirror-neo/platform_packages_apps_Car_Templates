<!--
  NOTE: Row view is non-clickable because we want the click even to be handled
  by its parent (RowContainerView), since that is the view that has the ripple
  effect, and may have other elements in it whose surface should also be
  clickable (e.g. any location markers)
  -->
<com.android.car.libraries.templates.host.view.widgets.common.RowView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="false"
    android:focusable="false">

  <!-- The radio button view. -->
  <FrameLayout
      android:id="@+id/row_radio_button_container"
      android:visibility="gone"
      android:focusable="false"
      android:layout_gravity="top"
      android:layout_marginEnd="@dimen/template_padding_3"
      android:layout_width="wrap_content"
      android:layout_height="?templateRowSelectionContainerHeight">
    <ImageView
        android:id="@+id/row_radio_button"
        android:layout_width="?templateRadioButtonSize"
        android:layout_height="?templateRadioButtonSize"
        android:layout_gravity="center"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />
  </FrameLayout>

  <!-- The row image or icon. -->
  <ImageView
      android:id="@+id/row_image"
      android:layout_width="?templateRowIconSize"
      android:layout_height="?templateRowIconSize"
      android:layout_gravity="top"
      android:layout_marginEnd="@dimen/template_padding_2"
      android:scaleType="fitCenter"
      android:visibility="gone"
      tools:ignore="ContentDescription" />

  <!-- A container with the title or secondary header,
      and the secondary text lines. -->
  <LinearLayout
      android:id="@+id/row_text_container"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:paddingStart="?templateRowTextHorizontalPadding"
      android:paddingEnd="?templateRowTextHorizontalPadding"
      android:orientation="vertical">

    <TextView
        android:id="@+id/row_title"
        style="?templateRowTitleStyle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Other secondary text lines may be added here programmatically -->
  </LinearLayout>

  <!-- The toggle view. -->
  <FrameLayout
      android:id="@+id/row_toggle_container"
      android:visibility="gone"
      android:focusable="false"
      android:layout_marginStart="@dimen/template_padding_1"
      android:layout_gravity="top"
      android:layout_width="wrap_content"
      android:layout_height="?templateRowSelectionContainerHeight">
    <Switch
        android:id="@+id/row_toggle"
        android:focusable="false"
        android:layout_gravity="center"
        android:layout_width="?templateToggleWidth"
        android:layout_height="?templateToggleHeight"/>
  </FrameLayout>

  <!-- The caret view, used for browsable rows. -->
  <ImageView
      android:visibility="gone"
      android:id="@+id/row_caret"
      android:layout_width="?templateRowIconSize"
      android:layout_height="?templateRowIconSize"
      android:layout_gravity="top"
      android:layout_marginEnd="@dimen/template_padding_1"
      android:scaleType="fitXY"
      android:src="@drawable/quantum_ic_navigate_next_vd_theme_24"
      tools:ignore="ContentDescription" />
</com.android.car.libraries.templates.host.view.widgets.common.RowView>

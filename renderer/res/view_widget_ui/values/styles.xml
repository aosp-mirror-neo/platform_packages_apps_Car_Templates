<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="SystemSdkHeadline1">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_headline_1_size</item>
        <item name="android:textColor">@color/system_sdk_headline1</item>
    </style>

    <style name="SystemSdkHeadline1.Dark" parent="SystemSdkHeadline1">
        <item name="android:textColor">@color/system_sdk_headline1_dark</item>
    </style>

    <style name="SystemSdkHeadline1.Light" parent="SystemSdkHeadline1">
        <item name="android:textColor">@color/system_sdk_headline1_light</item>
    </style>

    <style name="SystemSdkHeadline2">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_headline_2_size</item>
        <item name="android:textColor">@color/system_sdk_headline1</item>

    </style>

    <style name="SystemSdkHeadline2.Dark" parent="SystemSdkHeadline2">
        <item name="android:textColor">@color/system_sdk_headline1_dark</item>
    </style>

    <style name="SystemSdkHeadline2.Light" parent="SystemSdkHeadline2">
        <item name="android:textColor">@color/system_sdk_headline1_light</item>
    </style>

    <style name="SystemSdkTitle">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_title_size</item>
        <item name="android:textColor">@color/system_sdk_title</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SystemSdkTitle.Dark" parent="SystemSdkTitle">
        <item name="android:textColor">@color/system_sdk_title_dark</item>
    </style>

    <style name="SystemSdkTitle.Light" parent="SystemSdkTitle">
        <item name="android:textColor">@color/system_sdk_title_light</item>
    </style>

    <style name="SystemSdkBody1">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_body_1_size</item>
        <item name="android:textColor">@color/system_sdk_body1</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="SystemSdkBody1.Dark" parent="SystemSdkBody1">
        <item name="android:textColor">@color/system_sdk_body1_dark</item>

    </style>

    <style name="SystemSdkBody1.Light" parent="SystemSdkBody1">
        <item name="android:textColor">@color/system_sdk_body1_light</item>
    </style>

    <style name="SystemSdkBody2">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_body_2_size</item>
        <item name="android:textColor">@color/system_sdk_body2</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="SystemSdkBody2.Light">
        <item name="android:textColor">@color/system_sdk_body2_light</item>
    </style>

    <style name="SystemSdkCaption">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_caption_size</item>
        <item name="android:textColor">@color/system_sdk_caption</item>
    </style>

    <style name="SystemSdkCaption.Dark" parent="SystemSdkCaption">
        <item name="android:textColor">@color/system_sdk_caption_dark</item>
    </style>

    <style name="SystemSdkCaption.Light" parent="SystemSdkCaption">
        <item name="android:textColor">@color/system_sdk_caption_light</item>
    </style>

    <style name="SystemSdkMicro">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_micro_size</item>
        <item name="android:textColor">@color/system_sdk_micro</item>
    </style>

    <style name="SystemSdkMicro.Dark" parent="SystemSdkMicro">
        <item name="android:textColor">@color/system_sdk_micro_dark</item>
    </style>

    <style name="SystemSdkMicro.Light" parent="SystemSdkMicro">
        <item name="android:textColor">@color/system_sdk_micro_light</item>
    </style>

    <style name="SystemSdkDrawerArrowDrawable">
        <item name="carArrowColor">@android:color/white</item>
        <item name="carArrowSpinBars">true</item>
        <item name="carArrowThickness">2.5dp</item>
        <item name="carArrowDrawableSize">@dimen/system_sdk_drawer_header_menu_button_size</item>
        <item name="carArrowTopBottomBarSize">18dp</item>
        <item name="carArrowBarSize">28dp</item>
        <item name="carArrowMiddleBarSize">24dp</item>
        <item name="carArrowGapBetweenBars">6dp</item>
    </style>

    <style name="Toast">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_title_size</item>
        <item name="android:textColor">@color/system_sdk_grey_100</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SystemSdkToast">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_body_2_size</item>
        <item name="android:textColor">@color/system_sdk_grey_100</item>
    </style>

    <style name="SystemSdkContentBrowseNotification">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_body_2_size</item>
        <item name="android:textColor">@color/system_sdk_grey_100</item>
    </style>

    <style name="SystemSdkArtist">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/system_sdk_body_2_size</item>
        <item name="android:textColor">@color/system_sdk_grey_50</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!--
    ===============================
    ===== SDK related
    ===============================
    -->
    <style name="SystemSdkAppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="carButtonStyle">@style/SystemSdkButton</item>
        <item name="carCardStyle">@style/SystemSdkFloatingCard</item>
        <item name="carTextViewStyle">@style/SystemSdkTextView</item>
        <item name="android:textAppearance">@style/SystemSdkBody1</item>
    </style>

    <style name="SystemSdkFloatingCard">
        <item name="android:minWidth">@dimen/system_sdk_min_card_size</item>
        <item name="android:minHeight">@dimen/system_sdk_min_card_size</item>
        <item name="android:paddingTop">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingBottom">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingLeft">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingRight">@dimen/system_sdk_standard_margin</item>
        <item name="android:layout_marginTop">@dimen/system_sdk_standard_margin</item>
        <item name="android:layout_marginBottom">@dimen/system_sdk_standard_margin</item>
        <item name="android:layout_marginLeft">@dimen/system_sdk_standard_margin</item>
        <item name="android:layout_marginRight">@dimen/system_sdk_standard_margin</item>
        <item name="android:elevation">@dimen/system_sdk_standard_elevation</item>
        <item name="android:background">@color/system_sdk_card_background</item>
    </style>

    <style name="SystemSdkButtonGroup">
        <item name="android:paddingTop">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingBottom">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingLeft">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingRight">@dimen/system_sdk_standard_margin</item>
        <item name="android:elevation">@dimen/system_sdk_standard_elevation</item>
    </style>

    <style name="SystemSdkButton" parent="@android:style/Widget.ImageButton">
        <item name="android:minWidth">@dimen/system_sdk_standard_small_size</item>
        <item name="android:minHeight">@dimen/system_sdk_standard_small_size</item>
        <item name="android:paddingTop">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingBottom">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingLeft">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingRight">@dimen/system_sdk_standard_margin</item>
        <item name="android:elevation">@dimen/system_sdk_standard_elevation</item>
    </style>

    <style name="SystemSdkFilterNumber" parent="SystemSdkTitle" >
        <item name="android:textColor">@color/system_sdk_teal_700</item>
    </style>

    <style name="SystemSdkScribbleFilterText" parent="SystemSdkHeadline1" >
        <item name="android:textColor">@color/system_sdk_grey_600</item>
    </style>

    <style name="SystemSdkButton.Square">
        <item name="android:background">@drawable/system_sdk_rectangular_button_ripple</item>
    </style>

    <style name="SystemSdkButton.Square.Small">
    </style>

    <style name="SystemSdkButton.Square.Medium">
        <item name="android:minWidth">@dimen/system_sdk_standard_medium_size</item>
        <item name="android:minHeight">@dimen/system_sdk_standard_medium_size</item>
    </style>

    <style name="SystemSdkButton.Round">
        <item name="android:background">@drawable/system_sdk_oval_button_ripple</item>
    </style>

    <style name="SystemSdkButton.Round.Small">
    </style>

    <style name="SystemSdkButton.Round.Medium">
        <item name="android:minWidth">@dimen/system_sdk_standard_medium_size</item>
        <item name="android:minHeight">@dimen/system_sdk_standard_medium_size</item>
    </style>

    <style name="SystemSdkButton.UpDown">
        <item name="android:minHeight">@dimen/system_sdk_min_up_down_button_height</item>
        <item name="android:minWidth">@dimen/system_sdk_standard_small_size</item>
        <item name="android:paddingTop">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingBottom">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingLeft">@dimen/system_sdk_standard_margin</item>
        <item name="android:paddingRight">@dimen/system_sdk_standard_margin</item>
        <item name="android:elevation">@dimen/system_sdk_standard_elevation</item>
        <item name="android:background">@color/system_sdk_card_background</item>
    </style>

    <style name="SystemSdkButton.Toggle" parent="@style/SystemSdkButton.Round.Small">
        <item name="android:background">@drawable/system_sdk_toggle_button_ripple</item>
    </style>

    <style name="SystemSdkLabelButton">
        <item name="android:textAppearance">@style/SystemSdkBody1</item>
    </style>

    <style name="SystemSdkTextView">
        <item name="android:textAppearance">@style/SystemSdkBody1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLength">120</item>
    </style>

    <style name="SystemSdkTextView.Body1">
        <item name="android:singleLine">true</item>
    </style>

    <style name="SystemSdkTextView.Body2">
        <item name="android:textAppearance">@style/SystemSdkBody2</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>

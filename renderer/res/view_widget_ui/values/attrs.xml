<resources>
    <!-- Custom view attributes for
         {@link com.android.car.libraries.templates.host.view.widgets.ui.FocusClusterLayout} -->
    <declare-styleable name="FocusClusterLayout">
        <!-- The type of force field to apply. The default is "none" -->
        <attr name="forceFieldType">
            <!-- No force field -->
            <enum name="none" value="0"/>
            <!-- Force field intercepts all navigation events attempting to exit the layout and
                 handles them. -->
            <enum name="modal" value="1"/>
            <!-- Force field intercepts all navigation events attempting exit the layout during a
                 multi-move and handles them. -->
            <enum name="multimoveModal" value="2"/>
        </attr>
        <!-- Defines the relationship between the FocusClusterLayout and its descendants when
             requesting focus. -->
        <attr name="requestFocusDescendantFocusability">
            <!-- The FocusClusterLayout will use the default behavior, based on
                 descendantFocusability when requesting focus. -->
            <enum name="none" value="0"/>
            <!-- The FocusClusterLayout will get focus only if none of its descendants want it. -->
            <enum name="afterDescendants" value="1"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="PagedListView">
        <!-- Fade duration in ms -->
        <attr name="fadeLastItem" format="boolean" />
        <!-- Set to true/false to offset rows as they slide off screen. Defaults to true -->
        <attr name="offsetRows" format="boolean" />
        <attr name="glowColor" format="color" />
        <!-- Whether loading list view in drawer or not -->
        <attr name="rightGutterEnabled" format="boolean" />
        <!-- Whether to display the Scroll Bar or not. Defaults to true. -->
        <attr name="scrollBarEnabled" format="boolean" />
        <attr name="scrollBarWidthOverride" format="dimension"/>
        <!-- Declared in FocusClusterLayout -->
        <attr name="forceFieldType"/>
        <!-- Set to true to request focus on the child when scrollToPosition is called.
             Defaults to true. -->
        <attr name="scrollToPositionFocusRequestEnabled" format="boolean"/>
        <!-- Set to true to verify that the child is focusable before requesting focus when
             scrollToPosition is called. Defaults to false. -->
        <attr name="scrollToPositionFocusVerificationEnabled" format="boolean"/>
        <!-- Whether to show the pagination buttons in the scrollbar on non-touch input mode.
             Defaults to false. -->
        <attr name="paginationButtonsVisibleOnNonTouch" format="boolean" />
    </declare-styleable>

    <declare-styleable name="DrawerArrowDrawable">
        <!-- The drawing color for the bars -->
        <attr name="carArrowColor" format="color"/>
        <!-- Whether bars should rotate or not during transition -->
        <attr name="carArrowSpinBars" format="boolean"/>
        <!-- The total size of the drawable -->
        <attr name="carArrowDrawableSize" format="dimension"/>
        <!-- The max gap between the bars when they are parallel to each other -->
        <attr name="carArrowGapBetweenBars" format="dimension"/>
        <!-- The size of the top and bottom bars when they merge to the middle bar to form an arrow -->
        <attr name="carArrowTopBottomBarSize" format="dimension"/>
        <!-- The size of the middle bar when top and bottom bars merge into middle bar to form an arrow -->
        <attr name="carArrowMiddleBarSize" format="dimension"/>
        <!-- The size of the bars when they are parallel to each other -->
        <attr name="carArrowBarSize" format="dimension"/>
        <!-- The thickness (stroke size) for the bar paint -->
        <attr name="carArrowThickness" format="dimension"/>
    </declare-styleable>

    <attr name="carDrawerArrowStyle" format="reference" />

    <declare-styleable name="MaxWidthLayout">
        <!-- The max width of this layout -->
        <attr name="carMaxWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="SystemSdkAppTheme">
        <!-- The default style for FloatingActionButton in this app -->
        <attr name="carButtonStyle" format="reference" />
        <!-- The default card style in this app -->
        <attr name="carCardStyle" format="reference" />
        <!-- the default TextView style in this app -->
        <attr name="carTextViewStyle" format="reference" />
    </declare-styleable>

    <declare-styleable name="FloatingActionButton">
        <!-- The button type (custom, oval, rectangular, toggle) -->
        <attr name="buttonType" format="enum">
            <!-- A floating button with an unspecified background -->
            <enum name="custom" value="0" />
            <!-- A floating button with a round background -->
            <enum name="oval" value="1" />
            <!-- A floating button with a rectangular background -->
            <enum name="rectangular" value="2" />
            <!-- A floating button with a round background that can be toggled -->
            <enum name="toggle" value="3" />
        </attr>
        <!-- The animation that will be played when the button gains focus -->
        <attr name="focusGainedAnimation" format="reference" />
        <!-- The animation that will be played when the button loses focus -->
        <attr name="focusLostAnimation" format="reference" />
    </declare-styleable>
</resources>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="left">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Container for the page up button, to expand the tap target. -->
        <FrameLayout
            android:id="@+id/page_up_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="false"
            android:hapticFeedbackEnabled="false">

            <ImageView
                android:id="@+id/page_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/system_sdk_pagination_background"
                android:scaleType="center"
                android:duplicateParentState="true"
                android:src="@drawable/system_sdk_ic_up" />

        </FrameLayout>

        <!-- Container for the page down button, to expand the tap target. -->
        <FrameLayout
            android:id="@+id/page_down_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="false"
            android:hapticFeedbackEnabled="false">

            <ImageView
                android:id="@+id/page_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/system_sdk_pagination_background"
                android:scaleType="center"
                android:duplicateParentState="true"
                android:src="@drawable/system_sdk_ic_down" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/filler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/system_sdk_paged_list_view_scrollbar_thumb_margin"
        android:layout_marginTop="@dimen/system_sdk_paged_list_view_scrollbar_thumb_margin">

        <ImageView
            android:id="@+id/scrollbar_moving_thumb"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/system_sdk_scrollbar_thumb" />

        <FrameLayout
            android:id="@+id/action_button_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:visibility="gone"
            android:alpha="0"/>
    </FrameLayout>

</FrameLayout>

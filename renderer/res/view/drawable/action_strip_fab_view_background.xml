<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The background fill -->
  <item>
    <inset android:inset="@dimen/template_action_inset">
      <shape android:shape="rectangle">
        <!--
          Reference the color directly here instead of going through another
          theme attribute. If the configuration changes rapidly (e.g. repeatedly
          toggling day/night mode), there seems to be a timing issue depending
          on device where using a theme attribute here can resolve to a color
          from a different configuration than the one associated with this
          background resource xml. See b/162789867 for more context.
        -->
        <solid android:color="@color/template_black"/>
        <corners
            android:radius="?templateActionStripButtonCornerRadius"/>
      </shape>
    </inset>
  </item>

  <!-- Masked ripple layer -->
  <item android:drawable="@drawable/action_strip_button_ripple"/>
</layer-list>
